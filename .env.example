# Token from @BotFather
TELEGRAM_TOKEN=""
# Anthropic API key — all text generation and answer judging
ANTHROPIC_API_KEY=""
# OpenAI API key — text-to-speech only
OPENAI_API_TOKEN=""
# SQLite database file, relative to the working directory
SQLITE_PATH="./languagebot.db"
# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_TELEGRAM_USER_IDS=""
# Max user-initiated API interactions per user per day (0 = unlimited)
DAILY_API_CAP="300"
